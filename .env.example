MISTRAL_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Gemma 4 (modèle central du hackathon) : backend compatible OpenAI (vLLM ou
# Ollama en mode /v1). Changer ces deux valeurs suffit pour basculer de backend
# sans toucher au code (ex: tunnel local vers l'instance Brev sur le port 8000).
MODEL_BASE_URL=http://localhost:8000/v1
MODEL_NAME=google/gemma-4-E4B-it

# Alien Intelligence (source de vérité RAG, études médicales -- serveur MCP
# officiel du hackathon, get.alien.club/gemma4-hackathon). ALIEN_MCP_URL est
# optionnel : par défaut MedRxiv (medrxiv.mcp.alien.club/mcp) ; pointer sur
# biorxiv.mcp.alien.club/mcp pour l'autre cluster.
ALIEN_API_TOKEN=
ALIEN_MCP_URL=
